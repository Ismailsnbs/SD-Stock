generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// App-wide key/value settings toggled from the admin panel
// (e.g. whether the storefront shows a member their account balance).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Gym staff who use the admin panel.
model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// Members imported from the admin's customer Excel list.
model Customer {
  id              Int       @id @default(autoincrement())
  loginId         String    @unique // the id the member types to log in
  password        String // stored as plain per import; hashed on import
  name            String
  surname         String
  telephone       String?
  membershipStart DateTime  @default(now()) // join date — informational on the member card
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sales           Sale[]
  payments        Payment[]
}

// Money a member hands over — usually at their membership renewal.
// Balance = sum(sales.total) − sum(payments.amount). Partial payments allowed.
model Payment {
  id         Int      @id @default(autoincrement())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId Int
  amount     Float
  note       String?
  createdAt  DateTime @default(now())
}

// Products from the admin's stock Excel list.
model Product {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  count        Int      @default(0)
  buyingPrice  Float? // optional — unlocks profit in reports
  sellingPrice Float
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  saleItems    SaleItem[]
}

// One checkout (guest or logged-in member).
model Sale {
  id           Int        @id @default(autoincrement())
  customer     Customer?  @relation(fields: [customerId], references: [id])
  customerId   Int?
  customerName String // resolved display name (works for guest + login)
  mode         String // "guest" | "login"
  total        Float
  cost         Float      @default(0) // sum of buyingPrice*qty when known
  createdAt    DateTime   @default(now())
  items        SaleItem[]
}

model SaleItem {
  id           Int     @id @default(autoincrement())
  sale         Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId       Int
  product      Product @relation(fields: [productId], references: [id])
  productId    Int
  productName  String
  quantity     Int
  unitPrice    Float
  unitCost     Float? // buyingPrice at time of sale, if known
  lineTotal    Float
}
